{
  "name": "lattice-mod-manager",
  "productName": "Lattice",
  "version": "0.3.1",
  "description": "Менеджер модов и коллекций с графом совместимости и многопоточными загрузками там, где источник это разрешает",
  "author": "Lattice contributors",
  "license": "GPL-3.0-or-later",
  "private": true,
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && npm run build:main",
    "start": "electron .",
    "smoke": "npm run build && electron . --smoke",
    "icon": "electron scripts/make-icon.cjs",
    "dist": "npm run build && electron-builder --win --x64 --publish never",
    "demo": "vite --config vite.demo.config.ts",
    "build:demo": "vite build --config vite.demo.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "i18n": "node scripts/i18n.mjs"
  },
  "dependencies": {
    "7zip-bin": "5.2.0",
    "electron-updater": "6.8.11",
    "node-unrar-js": "2.0.2"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "7.8.0",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "fast-xml-parser": "5.12.0",
    "lucide-react": "1.67.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "semver": "7.8.6",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "yauzl": "3.4.0",
    "zustand": "5.0.16"
  },
  "build": {
    "appId": "app.lattice.modmanager",
    "productName": "Lattice",
    "copyright": "Lattice contributors, GPL-3.0-or-later",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/7zip-bin/**",
      "node_modules/node-unrar-js/**"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Lattice-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Lattice",
      "multiLanguageInstaller": true,
      "displayLanguageSelector": true,
      "installerLanguages": [
        "en_US",
        "zh_CN",
        "ru_RU",
        "es_ES",
        "pt_BR",
        "de_DE"
      ],
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "W1MR1",
        "repo": "lattice-mod-manager"
      }
    ]
  }
}
